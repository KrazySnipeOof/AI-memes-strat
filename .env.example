# Copy to .env. Everything here is for LIVE trading only - paper mode needs none of it.

# Wallet private key: base58 string (Phantom export) or JSON byte array (solana-keygen id.json).
# Use a dedicated burner wallet funded with only what the bot may trade. Never your main wallet.
MEMEBOT_PRIVATE_KEY=

# Live mode refuses to start unless this is exactly: yes
MEMEBOT_I_UNDERSTAND_THE_RISKS=

# Optional: dedicated RPC endpoint (strongly recommended for live - Helius, QuickNode, Triton).
# The public mainnet RPC is rate-limited and too slow for reliable live execution.
MEMEBOT_RPC_URL=

# Optional: Birdeye API key - enables the smart-money top-trader screen (free tier works).
BIRDEYE_API_KEY=
